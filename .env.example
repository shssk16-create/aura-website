# AURA AI Studio — environment configuration
#
# Copy this file to `.env.local` and fill in the inference endpoints for the
# open-weight models you want each agent to call. When an endpoint is left
# unset, the orchestrator falls back to a deterministic stub so the UI is
# fully usable for demos.

# ---------------------------------------------------------------------------
# Local data
# ---------------------------------------------------------------------------

# Persistent JSON store location (defaults to .data inside the project).
AURA_DATA_DIR=.data

# Optional shared secret for /api/jobs/worker. When set, pg_cron must send
# `Authorization: Bearer <value>` on every tick. Leave empty in local dev.
AURA_WORKER_SECRET=

# Path to the Python binary used by the typography sidecar. Default: python3.
AURA_PYTHON_BIN=

# ---------------------------------------------------------------------------
# NVIDIA NIM — text + vision
# ---------------------------------------------------------------------------

# Single NVIDIA NIM token. Powers:
#   - Vision Analyst        (nvidia/nemotron-3-nano-omni-30b-a3b-reasoning)
#   - Campaign Manager      (nvidia/llama-3.3-nemotron-super-49b-v1)
#   - Content Strategist    (nvidia/nemotron-3-nano-omni-30b-a3b-reasoning)
# Get one from https://build.nvidia.com/ — paste only the raw `nvapi-...`
# token.
Api=

# ---------------------------------------------------------------------------
# NVIDIA NIM — image generation
# ---------------------------------------------------------------------------

# FLUX 2 [klein] key (unanchored diffusion). Powers Creative Designer as a
# fallback when the Edify (ControlNet-anchored) path is unconfigured.
Flux=

# Edify Image 1 key. The PREFERRED diffusion backbone because it supports
# ControlNet reference-image anchoring, which prevents "product drift" when
# generating lifestyle scenes around a merchant's raw photo. When this key
# is set, the orchestrator chooses Edify over FLUX.
Edify=

# Optional custom Edify endpoint. Defaults to the public NVIDIA NIM URL.
EDIFY_API_URL=

# Optional custom vision endpoint (overrides the default NIM URL for the
# Vision Analyst).
VISION_API_URL=

# ---------------------------------------------------------------------------
# Z.AI / GLM — Saudi-dialect copywriter
# ---------------------------------------------------------------------------

# Z.AI / GLM API key. Powers the Copywriter (glm-4.5) when no self-hosted
# Saudi-Dialect LoRA endpoint is configured. Get one from
# https://z.ai/manage-apikey/apikey-list.
Glm=

# ---------------------------------------------------------------------------
# Custom legacy endpoints — only used when the NVIDIA / Z.AI keys above
# are unset.
# ---------------------------------------------------------------------------

# Campaign Manager + Data Analyst (DeepSeek-V4-Pro)
DEEPSEEK_API_URL=

# Content Strategist fallback (any OpenAI-style endpoint)
NEMOTRON_API_URL=

# Copywriter fallback (Jais-2 70B Chat)
JAIS_API_URL=

# Creative Designer (FLUX.1 / FLUX.2 hosted elsewhere)
FLUX_API_URL=

# Social Media Specialist (Qwen3-8B)
QWEN_API_URL=

# SEO Expert (Falcon-H1 Arabic 34B)
FALCON_API_URL=

# Video Creator (Cosmos-Transfer2.5)
COSMOS_API_URL=

# ---------------------------------------------------------------------------
# Supabase (Postgres + Auth + Storage)
# ---------------------------------------------------------------------------
#
# When these are set AND `@supabase/supabase-js` is installed, the platform
# persists state in Postgres (multi-tenant, RLS-enforced). When unset, the
# file-backed JSON store under AURA_DATA_DIR is used instead — see
# docs/ARCHITECTURE.md.
#
# Production deployments MUST point at a KSA-region Supabase project — see
# docs/COMPLIANCE.md.

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
