# AURA AI — environment configuration
#
# Copy this file to `.env.local` and fill in the inference endpoints for the
# open-weight models you want each agent to call. When an endpoint is left
# unset, the orchestrator falls back to a deterministic stub so the UI is
# fully usable for demos.

# Persistent JSON store location (defaults to .data inside the project).
AURA_DATA_DIR=.data

# NVIDIA NIM API key. Powers:
#   - Campaign Manager (nvidia/llama-3.3-nemotron-super-49b-v1)
#   - Content Strategist (nvidia/nemotron-3-nano-omni-30b-a3b-reasoning)
# Stored in the env var named by each agent's `inference.keyEnv` (`Api`).
Api=

# Z.AI / GLM API key. Powers:
#   - Copywriter (glm-4.5)
# Get one from https://z.ai/manage-apikey/apikey-list — paste only the raw
# token, with no `api_key = "..."` wrapper.
Glm=

# NVIDIA NIM image-generation API key. Powers:
#   - Creative Designer (black-forest-labs/flux.2-klein-4b)
# This is the same flavour of `nvapi-...` token as `Api` but kept separate so
# you can scope quotas per agent. Get one from https://build.nvidia.com/.
Flux=

# Custom (non-NIM) inference URLs — only used when NVIDIA_API_KEY is unset:

# Campaign Manager + Data Analyst (DeepSeek-V4-Pro)
DEEPSEEK_API_URL=

# Content Strategist fallback (any OpenAI-style endpoint)
NEMOTRON_API_URL=

# Copywriter (Jais-2 70B Chat)
JAIS_API_URL=

# Creative Designer (FLUX.1)
FLUX_API_URL=

# Social Media Specialist (Qwen3-8B)
QWEN_API_URL=

# SEO Expert (Falcon-H1 Arabic 34B)
FALCON_API_URL=

# Video Creator (Cosmos-Transfer2.5)
COSMOS_API_URL=
