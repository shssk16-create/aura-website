# AURA AI — environment configuration
#
# Copy this file to `.env.local` and fill in the inference endpoints for the
# open-weight models you want each agent to call. When an endpoint is left
# unset, the orchestrator falls back to a deterministic stub so the UI is
# fully usable for demos.

# Persistent JSON store location (defaults to .data inside the project).
AURA_DATA_DIR=.data

# NVIDIA NIM API key. When set, the Campaign Manager (Nemotron Super 49B) and
# Content Strategist (Nemotron 3 Nano Omni 30B-A3B Reasoning) call NIM at
# https://integrate.api.nvidia.com/v1/chat/completions with this Bearer token.
# Either NVIDIA_API_KEY or Api works; the orchestrator checks both.
NVIDIA_API_KEY=
# Api=

# Custom (non-NIM) inference URLs — only used when NVIDIA_API_KEY is unset:

# Campaign Manager + Data Analyst (DeepSeek-V4-Pro)
DEEPSEEK_API_URL=

# Content Strategist fallback (any OpenAI-style endpoint)
NEMOTRON_API_URL=

# Copywriter (Jais-2 70B Chat)
JAIS_API_URL=

# Creative Designer (FLUX.1)
FLUX_API_URL=

# Social Media Specialist (Qwen3-8B)
QWEN_API_URL=

# SEO Expert (Falcon-H1 Arabic 34B)
FALCON_API_URL=

# Video Creator (Cosmos-Transfer2.5)
COSMOS_API_URL=
